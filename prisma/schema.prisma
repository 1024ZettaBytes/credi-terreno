// Prisma Schema - CrediTerreno
// Sistema profesional de administración de terrenos y créditos.
// Clean Architecture + Features. Decimal para precisión financiera.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// USUARIOS / SEGURIDAD (RBAC)
// ============================================================
model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  name      String?
  role      UserRole @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pagosRegistrados Pago[]     @relation("PagoRegistradoPor")
  ventasCreadas    Venta[]    @relation("VentaCreadaPor")
  traspasos        Traspaso[] @relation("TraspasoCreadoPor")

  @@map("users")
}

enum UserRole {
  ADMIN
  USER
}

// ============================================================
// INVENTORY: MANZANA + LOTE
// ============================================================
model Manzana {
  id          String   @id @default(cuid())
  nombre      String   @unique
  descripcion String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lotes Lote[]

  @@map("manzanas")
}

model Lote {
  id           String      @id @default(cuid())
  manzanaId    String
  manzana      Manzana     @relation(fields: [manzanaId], references: [id], onDelete: Restrict)
  numLote      String
  superficieM2 Decimal     @db.Decimal(12, 2)
  precioM2     Decimal     @db.Decimal(12, 2)
  totalPrecio  Decimal     @db.Decimal(14, 2)
  estatus      EstatusLote @default(DISPONIBLE)
  notas        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  ventas Venta[]

  @@unique([manzanaId, numLote])
  @@index([estatus])
  @@map("lotes")
}

enum EstatusLote {
  DISPONIBLE
  VENDIDO
  RECUPERADO
  TRASPASADO
}

// ============================================================
// CLIENTES (con expediente)
// ============================================================
model Cliente {
  id         String   @id @default(cuid())
  nombre     String
  telefono   String
  domicilio  String
  email      String?
  curp       String?  @unique
  rfc        String?
  expediente String[] @default([])
  notas      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  ventas              Venta[]
  traspasosAnteriores Traspaso[] @relation("ClienteAnteriorTraspaso")
  traspasosNuevos     Traspaso[] @relation("ClienteNuevoTraspaso")

  @@map("clientes")
}

// ============================================================
// VENDEDORES
// ============================================================
model Vendedor {
  id                 String   @id @default(cuid())
  nombre             String
  telefono           String?
  email              String?
  comisionPorcentaje Decimal  @db.Decimal(5, 2) @default(0)
  activo             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  ventas Venta[]

  @@map("vendedores")
}

// ============================================================
// VENTAS (CRÉDITOS)
// ============================================================
model Venta {
  id                         String       @id @default(cuid())
  loteId                     String
  lote                       Lote         @relation(fields: [loteId], references: [id], onDelete: Restrict)
  clienteId                  String
  cliente                    Cliente      @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  vendedorId                 String?
  vendedor                   Vendedor?    @relation(fields: [vendedorId], references: [id], onDelete: SetNull)

  fechaVenta                 DateTime     @default(now())
  precioTotal                Decimal      @db.Decimal(14, 2)
  enganche                   Decimal      @db.Decimal(14, 2)
  montoFinanciado            Decimal      @db.Decimal(14, 2)
  mensualidadBase            Decimal      @db.Decimal(12, 2)
  plazoMeses                 Int
  diaPago                    Int
  interesMoratorioPorcentaje Decimal      @db.Decimal(5, 2) @default(5.0)

  // Estado vivo del crédito (se actualiza con cada pago)
  proximaFechaPago           DateTime
  saldoMensualidadActual     Decimal      @db.Decimal(12, 2)
  numeroMensualidadActual    Int          @default(1)
  saldoCapital               Decimal      @db.Decimal(14, 2)

  comisionPorcentaje         Decimal      @db.Decimal(5, 2) @default(0)
  comisionMonto              Decimal      @db.Decimal(14, 2) @default(0)

  estatus                    EstatusVenta @default(ACTIVO)
  fechaCierre                DateTime?
  notas                      String?

  createdById                String?
  createdBy                  User?        @relation("VentaCreadaPor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt                  DateTime     @default(now())
  updatedAt                  DateTime     @updatedAt

  pagos            Pago[]
  traspasoOriginal Traspaso?     @relation("TraspasoVentaOriginal")
  traspasoGenerado Traspaso?     @relation("TraspasoVentaNueva")
  recuperacion     Recuperacion?

  @@index([estatus])
  @@index([loteId])
  @@index([clienteId])
  @@map("ventas")
}

enum EstatusVenta {
  ACTIVO
  LIQUIDADO
  TRASPASADO
  CANCELADO
}

// ============================================================
// PAGOS
// ============================================================
model Pago {
  id             String    @id @default(cuid())
  ventaId        String
  venta          Venta     @relation(fields: [ventaId], references: [id], onDelete: Restrict)

  monto          Decimal   @db.Decimal(14, 2)
  fechaRegistro  DateTime  @default(now())
  fechaPeriodo   DateTime?
  tipo           TipoPago
  periodoMes     Int?
  periodoAnio    Int?
  diasMora       Int?
  comprobanteUrl String?
  notas          String?

  registradoPorId String?
  registradoPor   User?    @relation("PagoRegistradoPor", fields: [registradoPorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ventaId])
  @@index([fechaRegistro])
  @@map("pagos")
}

enum TipoPago {
  ENGANCHE
  MENSUALIDAD
  ABONO_CAPITAL
  MORATORIO
  LIQUIDACION
}

// ============================================================
// TRASPASOS (cambio de titular)
// ============================================================
model Traspaso {
  id                String  @id @default(cuid())
  ventaOriginalId   String  @unique
  ventaOriginal     Venta   @relation("TraspasoVentaOriginal", fields: [ventaOriginalId], references: [id], onDelete: Restrict)
  ventaNuevaId      String? @unique
  ventaNueva        Venta?  @relation("TraspasoVentaNueva", fields: [ventaNuevaId], references: [id], onDelete: SetNull)

  clienteAnteriorId String
  clienteAnterior   Cliente @relation("ClienteAnteriorTraspaso", fields: [clienteAnteriorId], references: [id], onDelete: Restrict)
  clienteNuevoId    String
  clienteNuevo      Cliente @relation("ClienteNuevoTraspaso", fields: [clienteNuevoId], references: [id], onDelete: Restrict)

  fechaTraspaso DateTime @default(now())
  costoTraspaso Decimal  @db.Decimal(14, 2) @default(0)
  notas         String?

  createdById String?
  createdBy   User?    @relation("TraspasoCreadoPor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("traspasos")
}

// ============================================================
// RECUPERACIÓN (rescisión)
// ============================================================
model Recuperacion {
  id                   String   @id @default(cuid())
  ventaId              String   @unique
  venta                Venta    @relation(fields: [ventaId], references: [id], onDelete: Restrict)

  fechaRecuperacion    DateTime @default(now())
  totalPagadoCliente   Decimal  @db.Decimal(14, 2)
  porcentajeDevolucion Decimal  @db.Decimal(5, 2)
  montoDevolucion      Decimal  @db.Decimal(14, 2)
  motivo               String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("recuperaciones")
}

// Prisma Schema para Sistema de Gestión de Créditos Inmobiliarios
// CrediTerreno - Administración de Terrenos y Contratos

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// MODELO DE USUARIO (para autenticación)
// ============================================
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String    // Hash de contraseña
  name          String?
  role          UserRole  @default(ADMIN)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Relaciones de auditoría
  pagosRegistrados Pago[] @relation("RegistradoPor")

  @@map("users")
}

enum UserRole {
  ADMIN
  VENDEDOR
  CONTADOR
}

// ============================================
// MODELO DE CLIENTE
// ============================================
model Cliente {
  id              String    @id @default(cuid())
  nombreCompleto  String
  domicilio       String
  telefono        String
  email           String?
  curp            String?   @unique
  rfc             String?
  
  // Timestamps
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // Relaciones
  contratos       Contrato[]

  @@map("clientes")
}

// ============================================
// MODELO DE TERRENO
// ============================================
model Terreno {
  id              String         @id @default(cuid())
  identificador   String         @unique  // Ej: "Lote 5, Manzana A"
  descripcion     String?
  
  // Precio en formato Decimal para precisión financiera
  precioLista     Decimal        @db.Decimal(12, 2)
  
  // Estado del terreno
  estado          EstadoTerreno  @default(DISPONIBLE)
  
  // Coordenadas para el mapa visual (posición relativa en %)
  coordenadaX     Float          // Posición X (left) en porcentaje 0-100
  coordenadaY     Float          // Posición Y (top) en porcentaje 0-100
  
  // Dimensiones opcionales
  superficie      Float?         // Metros cuadrados
  frente          Float?         // Metros de frente
  fondo           Float?         // Metros de fondo
  
  // Timestamps
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  
  // Relaciones
  contratos       Contrato[]

  @@map("terrenos")
}

enum EstadoTerreno {
  DISPONIBLE
  APARTADO
  VENDIDO
}

// ============================================
// MODELO DE CONTRATO
// ============================================
model Contrato {
  id                String    @id @default(cuid())
  
  // Relaciones principales
  clienteId         String
  cliente           Cliente   @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  
  terrenoId         String
  terreno           Terreno   @relation(fields: [terrenoId], references: [id], onDelete: Restrict)
  
  // Información financiera (Decimal para precisión)
  precioVenta       Decimal   @db.Decimal(12, 2)  // Precio acordado de venta
  enganche          Decimal   @db.Decimal(12, 2)  // Monto del enganche
  
  // Configuración de pagos
  diaPagoMensual    Int       @default(15)        // Día del mes para pagar (1-31)
  plazoMeses        Int       @default(12)        // Número de mensualidades
  montoMensualidad  Decimal   @db.Decimal(12, 2)  // Monto fijo de cada mensualidad
  
  // Tasa de mora (porcentaje diario, ej: 0.5 = 0.5% diario)
  tasaMoraDiaria    Decimal   @db.Decimal(5, 4)   @default(0.0050)
  
  // Estado del contrato
  estado            EstadoContrato @default(ACTIVO)
  fechaInicio       DateTime  @default(now())
  fechaFin          DateTime?
  
  // Timestamps
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  // Relaciones
  pagos             Pago[]

  @@unique([clienteId, terrenoId])
  @@map("contratos")
}

enum EstadoContrato {
  ACTIVO
  LIQUIDADO
  CANCELADO
  EN_MORA
}

// ============================================
// MODELO DE PAGO
// ============================================
model Pago {
  id              String    @id @default(cuid())
  
  // Relación con contrato
  contratoId      String
  contrato        Contrato  @relation(fields: [contratoId], references: [id], onDelete: Restrict)
  
  // Información del pago (Decimal para precisión)
  monto           Decimal   @db.Decimal(12, 2)
  fechaPago       DateTime  @default(now())
  
  // Tipo de pago
  tipo            TipoPago
  
  // Información adicional
  numeroPago      Int?      // Número de mensualidad (1, 2, 3...)
  periodoMes      Int?      // Mes al que corresponde este pago (1-12)
  periodoAnio     Int?      // Año al que corresponde este pago
  
  // Para pagos de mora
  diasMora        Int?      // Días de atraso que cubre este pago
  
  // Método de pago
  metodoPago      MetodoPago @default(EFECTIVO)
  referencia      String?    // Número de referencia/folio
  comprobante     String?    // URL del comprobante
  
  // Notas adicionales
  notas           String?
  
  // Quién registró el pago
  registradoPorId String?
  registradoPor   User?     @relation("RegistradoPor", fields: [registradoPorId], references: [id])
  
  // Timestamps
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("pagos")
}

enum TipoPago {
  ENGANCHE
  MENSUALIDAD
  INTERES_MORA
  ABONO_CAPITAL
  LIQUIDACION
}

enum MetodoPago {
  EFECTIVO
  TRANSFERENCIA
  CHEQUE
  TARJETA
  OTRO
}
